          "pm.test(`${id} 回應時間 < 1000ms`, () => pm.expect(pm.response.responseTime).to.be.below(1000));",
          "pm.test(`${id} 回應是 JSON`, () => pm.response.to.have.header('Content-Type', 'application/json'));",
          "if (pm.response.code >= 400) {",
          "    pm.test(`${id} 錯誤回應格式統一`, () => pm.response.to.have.jsonSchema({",
