                  "// 這個資料夾要搭配 CSV 跑（Collection Runner 選資料檔，或 newman -d）；沒有資料就跳過",
                  "if (!pm.iterationData.get('case_id')) { pm.execution.skipRequest(); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const c = pm.iterationData.toObject();",
                  "pm.test(`${c.case_id} ${c.title}：回 ${c.expected_status}`, () => pm.response.to.have.status(Number(c.expected_status)));",
                  "if (c.expected_error_code) {",
                  "    pm.test(`${c.case_id} error_code 是 ${c.expected_error_code}`, () => pm.expect(pm.response.json().error_code).to.eql(c.expected_error_code));",
                  "} else {",
                  "    pm.test(`${c.case_id} 餘額一分不差是 ${c.expected_balance}`, () => pm.expect(pm.response.json().balance).to.eql(c.expected_balance));",
                  "}"
                ]
              }
